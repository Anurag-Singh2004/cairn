# CAIRN environment variables (copy to .env and adjust)
# See context.md §12 for documentation.

# Directory for per-run output (manifests, events, checkpoints, receipts, reports)
CAIRN_RUN_DIR=runs

# Directory for Ed25519 key pair (private key must be 0600)
CAIRN_KEY_DIR=keys

# Default tier (t0 or t1)
CAIRN_TIER=t1
